# =============================================================================
# AI TRADING PLATFORM - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# Use Supabase or Neon for cloud deployments
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/trading_db"

# -----------------------------------------------------------------------------
# REDIS
# Use Upstash Redis for cloud deployments (free tier available)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# AUTHENTICATION
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET="replace-with-64-char-random-hex-string"
SESSION_SECRET="replace-with-another-64-char-random-hex-string"

# Dashboard access password (hashed at startup)
DASHBOARD_PASSWORD="change-this-to-a-strong-password"

# -----------------------------------------------------------------------------
# AI PROVIDER
# Supported: openai | anthropic | groq | ollama
# Set AI_ENABLED=false to disable AI entirely (rule-based mode)
# -----------------------------------------------------------------------------
AI_PROVIDER="groq"
AI_API_KEY="your-ai-api-key-here"
AI_MODEL="llama-3.3-70b-versatile"
AI_ENABLED=true

# What to do when AI is unavailable or rate-limited:
#   NO_TRADE  — Skip the trade (safer default for live trading)
#   RULE_BASED — Proceed using strategy engine signals only
AI_UNAVAILABLE_MODE=NO_TRADE

# AI rate limits (tune to your provider's free tier)
AI_MAX_REQUESTS_PER_MINUTE=3
AI_MAX_REQUESTS_PER_DAY=50
AI_REQUEST_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# EXCHANGE / BROKER
# Initially: paper trading only. Set LIVE_TRADING=false until ready.
# -----------------------------------------------------------------------------
EXCHANGE_PROVIDER="binance"
EXCHANGE_API_KEY="your-exchange-api-key"
EXCHANGE_API_SECRET="your-exchange-api-secret"

# Use testnet/sandbox environment
EXCHANGE_TESTNET=true

# Paper trading uses real market data but virtual capital
PAPER_TRADING=true
PAPER_INITIAL_BALANCE=10000

# Live trading — requires explicit opt-in
LIVE_TRADING=false

# -----------------------------------------------------------------------------
# RISK DEFAULTS
# These can also be overridden per-user from the dashboard
# -----------------------------------------------------------------------------
RISK_PER_TRADE=0.01           # 1% of account per trade
MIN_RISK_REWARD=2.0           # Minimum 2:1 reward-to-risk ratio
MAX_DAILY_LOSS=0.03           # 3% max daily drawdown
MAX_WEEKLY_LOSS=0.06          # 6% max weekly drawdown
MAX_DRAWDOWN=0.10             # 10% max total drawdown
MAX_TRADES_PER_DAY=5
MAX_OPEN_POSITIONS=3
MAX_LEVERAGE=1                # 1 = no leverage (spot only)

# -----------------------------------------------------------------------------
# WORKER CONFIGURATION
# -----------------------------------------------------------------------------
WORKER_HEARTBEAT_INTERVAL_MS=15000   # 15 seconds
WORKER_STALE_THRESHOLD_MS=60000      # 1 minute — alert if no heartbeat
MARKET_DATA_POLL_INTERVAL_MS=60000   # 1 minute polling
STRATEGY_CHECK_INTERVAL_MS=300000    # 5 minutes strategy evaluation

# -----------------------------------------------------------------------------
# API SERVER
# -----------------------------------------------------------------------------
API_PORT=3001
API_HOST="0.0.0.0"
API_CORS_ORIGIN="http://localhost:3000"

# -----------------------------------------------------------------------------
# FRONTEND (Next.js)
# Only NEXT_PUBLIC_ vars are exposed to the browser
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="info"   # debug | info | warn | error
